# ============================================
# Travel Diary Backend - Environment Variables
# Copy this file to ".env" and fill in values.
# NEVER commit the real .env file to GitHub!
# ============================================

# Port the backend server runs on
PORT=5000

# MongoDB Atlas connection string
# Get this from Atlas: Database > Connect > Drivers
MONGODB_URI=MONGODB_URI=mongodb+srv://traveladmin:TravelDiary2026Prasad@ecommercecluster.hk2qrm3.mongodb.net/travel_diary
# Secret used to sign JWT tokens (use a long random string)
JWT_SECRET=change_this_to_a_long_random_secret_string_123456789

# Default admin account created by the seed script
ADMIN_EMAIL=admin@traveldiary.com
ADMIN_PASSWORD=admin123

# Frontend URL allowed by CORS
CLIENT_URL=http://localhost:5173
